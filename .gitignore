# macOS
.DS_Store

# Xcode project - regenerated from project.yml via `xcodegen generate`,
# so it doesn't need to be committed (and merges badly if it is).
DinoCode.xcodeproj/

# Xcode user/build state (kept anyway in case the project file itself
# is ever committed on a fork that skips xcodegen)
xcuserdata/
*.xcuserstate
*.xcscmblueprint

# Build products
build/
DerivedData/
*.ipa
*.dSYM.zip
*.dSYM

# Swift Package Manager
.swiftpm/
.build/

# CocoaPods / Carthage (unused here, ignored defensively)
Pods/
Carthage/Build/
